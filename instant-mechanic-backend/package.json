{
  "name": "instant-mechanic-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style backend for the Instant Mechanic live vehicle service operations dashboard.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
